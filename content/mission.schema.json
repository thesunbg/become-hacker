{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zero-root.game/schemas/mission.schema.json",
  "title": "ZERO -> ROOT mission definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "chapter",
    "title",
    "difficulty",
    "estimatedMinutes",
    "story",
    "objective",
    "environment",
    "tasks",
    "hints",
    "knowledge",
    "skills",
    "xp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ch[0-9]{2}-mission-[0-9]{3}$",
      "description": "Stable mission id, e.g. ch01-mission-001."
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Rendered as stars in the UI."
    },
    "estimatedMinutes": {
      "type": "integer",
      "minimum": 1
    },
    "story": {
      "type": "string",
      "minLength": 1,
      "description": "Narrative briefing. Sets up the question without answering it."
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "description": "What the player must achieve, stated without revealing how."
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "image"],
      "properties": {
        "type": {
          "enum": ["terminal", "terminal+browser", "browser"]
        },
        "image": {
          "type": "string",
          "description": "Directory name under labs/ providing this sandbox."
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "description"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "COMMAND",
              "FILE_FOUND",
              "TEXT_FOUND",
              "PORT_FOUND",
              "HTTP_REQUEST",
              "FLAG_FOUND",
              "ANSWER",
              "CONFIG_CHANGED",
              "SERVICE_DISCOVERED",
              "LOG_ANALYSIS"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "Shown to the player as a checklist item."
          },
          "target": {
            "type": "string",
            "description": "Path, command, port, string or answer the engine matches on."
          },
          "optional": {
            "type": "boolean",
            "default": false,
            "description": "Bonus objective: awards XP but is not required to complete."
          },
          "xp": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "hints": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "description": "Escalating conceptual -> concrete. Level 1 must not reveal the answer.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "text", "xpCost"],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "xpCost": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "flag": {
      "type": "string",
      "minLength": 1,
      "description": "SERVER-SIDE ONLY. Must never be serialised into a client response. Required when the mission has a FLAG_FOUND task; omit it for missions that complete purely through tasks."
    },
    "knowledge": {
      "type": "array",
      "minItems": 1,
      "description": "The post-mission review: what the player actually learned.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["concept", "explanation"],
        "properties": {
          "concept": {
            "type": "string",
            "minLength": 1
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "realWorld": {
            "type": "string",
            "description": "Game concept -> security concept -> real world mapping."
          }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["skill", "amount"],
        "properties": {
          "skill": {
            "enum": [
              "LINUX",
              "NETWORKING",
              "WEB",
              "PROGRAMMING",
              "CRYPTOGRAPHY",
              "OSINT",
              "FORENSICS",
              "REVERSE_ENGINEERING",
              "CLOUD",
              "RED_TEAM",
              "BLUE_TEAM",
              "PROBLEM_SOLVING"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "xp": {
      "type": "integer",
      "minimum": 0
    },
    "requires": {
      "type": "array",
      "description": "Mission ids that must be COMPLETED before this one leaves LOCKED.",
      "items": {
        "type": "string",
        "pattern": "^ch[0-9]{2}-mission-[0-9]{3}$"
      }
    }
  }
}
