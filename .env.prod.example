# ZERO -> ROOT — production environment for docker-compose.prod.yml.
# Copy to .env on the VPS and fill in. Never commit the filled-in copy.

# The hostname players visit. Caddy gets a certificate for it automatically, so it must
# already point at this server's IP before you start the https profile.
DOMAIN=play.example.com
WEB_ORIGIN=https://play.example.com

# openssl rand -hex 32
SESSION_SECRET=
# openssl rand -hex 24  — shared between the game service and the lab manager.
LAB_MANAGER_TOKEN=
# openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Lab limits -------------------------------------------------------------
# Ceilings per sandbox. The lab manager clamps these to the bounds in
# docs/06-security.md, so a careless value degrades the game rather than handing a
# player a machine worth attacking. Size the VPS by concurrent players, not accounts.
LAB_CPU_LIMIT=1
LAB_MEMORY_LIMIT=512m
LAB_PIDS_LIMIT=128
LAB_SESSION_TIMEOUT_SECONDS=3600

# --- Escape hatch -----------------------------------------------------------
# Leave this alone unless you are reaching the server by IP before DNS and a
# certificate exist. Setting it to false sends the session cookie over plain HTTP,
# where anyone on the path can read it and sign in as that player. Set it back to
# true the moment you have a domain.
# SESSION_COOKIE_SECURE=false
