# ZERO -> ROOT — local development defaults.
# Copy to .env.local and adjust. NEVER commit real secrets.

NODE_ENV=development

# --- API ---
API_PORT=3001
WEB_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_URL=postgresql://zeroroot:zeroroot@localhost:5432/zeroroot

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=replace-me-with-32-bytes-of-hex
SESSION_COOKIE_NAME=zr_session
SESSION_TTL_SECONDS=86400

# --- Lab manager ---
LAB_MANAGER_URL=http://localhost:3002
# Hard ceilings enforced per lab container (docs/02-security.md section 48)
LAB_CPU_LIMIT=1
LAB_MEMORY_LIMIT=512m
LAB_PIDS_LIMIT=128
LAB_SESSION_TIMEOUT_SECONDS=3600
# Labs MUST run on an isolated network with no route to the internet.
LAB_NETWORK=zeroroot-lab
